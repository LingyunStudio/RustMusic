{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustMusic",
  "version": "0.1.8",
  "identifier": "com.rustmusic.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "RustMusic",
        "width": 1280,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0b0b10"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
